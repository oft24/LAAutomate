# Entornos virtuales (cada equipo crea el suyo)
.venv/
venv/
__pycache__/
*.py[cod]

# Configuracion real del equipo: nombres de servidores, correos, webhooks.
# Solo se versiona .env.example con placeholders.
.env

# Estado de ejecucion -- se regenera solo, no es codigo
logs/
core/rpa.db
*.log

# Empaquetado con PyInstaller
build/
dist/

# Artefactos de la demo de comparativos: solo se versiona la plantilla
# ficticia de entrada; reportes, renders e inspecciones son locales.
outputs/*
!outputs/demo-compras/
outputs/demo-compras/*
!outputs/demo-compras/productos.xlsx
se-metadata.json

# Herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/

# Datos de entrada/salida de las automatizaciones. La plantilla la genera
# `python tools/plantilla_curp.py`, asi que no hace falta versionarla -- y
# este es justo el sitio donde acabarian datos personales reales.
datos/

# Material de trabajo personal que quedo en la carpeta del proyecto.
.codex-doc-review/

# Respaldos que deja el instalador
LaAutomate_respaldos/

# Copiar a .env — nunca commitear el .env real.
#   copy .env.example .env
#
# Aqui van datos del equipo/entorno, NO contraseñas: esas viven en la
# Boveda de credenciales (Windows Credential Manager, via keyring).

# Asistente IA (opcional). Es preferible guardar la clave desde la propia
# vista: queda en el Administrador de credenciales de Windows y no en disco.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Automatizacion "curp_desde_excel": de donde lee y donde deja los PDF.
CURP_EXCEL=
CURP_CARPETA=
CURP_PAUSA=6

# Automatizacion "buscar_videos_youtube".
YT_MAX_RESULTADOS=5
YT_PAUSA=3

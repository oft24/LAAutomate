# Copiar a .env — nunca commitear el .env real.
#   copy .env.example .env
#
# Aqui van datos del equipo/entorno, NO contraseñas: esas viven en la
# Bóveda de credenciales (Windows Credential Manager, via keyring).

# Alertas cuando una automatizacion falla (opcional).
TEAMS_WEBHOOK_URL=

# Automatizacion "alerta_diaria_errores": identifica tu chat contigo
# mismo en Teams, donde se pega la tabla de errores.
CORREO_PROPIO=tu.correo@empresa.com
NOMBRE_CHAT_PROPIO="Tu Nombre (You)"

# Automatizaciones grabadas contra UltraVNC (ingresointento5, intento10,
# ingresovnc2): a que servidor se conectan y con que usuario.
VNC_SERVIDOR=servidor.demo
VNC_SERVIDOR_ALT=servidor.demo2
VNC_USUARIO=usuario.demo
VNC_IP=127.0.0.1
